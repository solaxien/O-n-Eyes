FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY browser/package.json browser/package-lock.json ./
RUN npm ci --ignore-scripts
COPY browser/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
WORKDIR /app
COPY --from=web /web/dist /app/browser/dist
COPY scripts/serve_device.py /app/scripts/serve_device.py
USER 65534:65534
EXPOSE 7860
CMD ["python", "scripts/serve_device.py", "--bind", "0.0.0.0", "--port", "7860", "--remote-models", "https://github.com/solaxien/O-n-Eyes/releases/download/browser-models-v3"]
